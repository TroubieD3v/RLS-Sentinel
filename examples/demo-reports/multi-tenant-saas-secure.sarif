              "name": "UncoveredTenantTableOperation",
              "shortDescription": {
                "text": "Uncovered tenant table / operation"
              },
              "fullDescription": {
                "text": "A protected table or SQL operation has no expectation in the spec, so its boundary is unverified. This is coverage tracking, not a vulnerability by itself."
              },
              "help": {
                "text": "Add ALLOW/DENY expectations for the missing actor/operation combinations.\nMinimum evidence: Coverage tracking, not vulnerability by itself",
                "markdown": "**Remediation:** Add ALLOW/DENY expectations for the missing actor/operation combinations.\n\n**Minimum evidence:** Coverage tracking, not vulnerability by itself"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "coverage"
                ],
                "precision": "medium"
              },
              "helpUri": "https://www.postgresql.org/docs/current/ddl-rowsecurity.html"
            }
          ],
          "properties": {
            "ruleset": "2026.10.1"
          }
        }
