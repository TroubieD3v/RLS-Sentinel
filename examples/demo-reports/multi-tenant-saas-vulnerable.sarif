{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "RLS Sentinel",
          "version": "1.0.0",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "RLS-002",
              "name": "ExcessivelyBroadPermissivePolicy",
              "shortDescription": {
                "text": "Excessively broad permissive policy"
              },
              "fullDescription": {
                "text": "A permissive policy whose expression is constant TRUE applies to roles that the spec expects to be tenant-bounded. Permissive policies are OR-ed, so one broad policy removes the tenant filter."
              },
              "help": {
                "text": "Replace the constant expression with a tenant-bounded predicate, or restrict the policy to the specific role that legitimately needs broad access.\nMinimum evidence: Applicable policy + expected row boundary",
                "markdown": "**Remediation:** Replace the constant expression with a tenant-bounded predicate, or restrict the policy to the specific role that legitimately needs broad access.\n\n**Minimum evidence:** Applicable policy + expected row boundary"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "policy"
                ],
                "precision": "high"
              },
              "helpUri": "https://www.postgresql.org/docs/current/sql-createpolicy.html"
            },
            {
              "id": "RLS-003",
              "name": "UnintendedPublicRolePolicyOrGrant",
              "shortDescription": {
                "text": "Unintended PUBLIC role policy or grant"
              },
              "fullDescription": {
                "text": "A policy or table grant targets PUBLIC, i.e. every current and future role, on a protected table."
              },
              "help": {
                "text": "Target an explicit role (TO app_user) instead of PUBLIC and REVOKE ... FROM PUBLIC.\nMinimum evidence: Role scope + target exposure context",
                "markdown": "**Remediation:** Target an explicit role (TO app_user) instead of PUBLIC and REVOKE ... FROM PUBLIC.\n\n**Minimum evidence:** Role scope + target exposure context"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "exposure"
                ],
                "precision": "medium"
              },
              "helpUri": "https://www.postgresql.org/docs/current/sql-createpolicy.html"
            },
            {
              "id": "RLS-005",
              "name": "InsertUpdateMissingOrIneffectiveNewRowGuard",
              "shortDescription": {
                "text": "INSERT / UPDATE missing or ineffective new-row guard"
              },
              "fullDescription": {
                "text": "A WITH CHECK expression is absent, constant TRUE or does not bind the tenant column, so a role can create or move rows into a tenant it does not belong to."
              },
              "help": {
                "text": "Add or tighten WITH CHECK so the new row satisfies the same tenant predicate as USING.\nMinimum evidence: DML-specific semantics / runtime test",
                "markdown": "**Remediation:** Add or tighten WITH CHECK so the new row satisfies the same tenant predicate as USING.\n\n**Minimum evidence:** DML-specific semantics / runtime test"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "policy"
                ],
                "precision": "high"
              },
              "helpUri": "https://www.postgresql.org/docs/current/sql-createpolicy.html"
            },
            {
              "id": "RLS-006",
              "name": "CrossTenantSelectVisibility",
              "shortDescription": {
                "text": "Cross-tenant SELECT visibility"
              },
              "fullDescription": {
                "text": "A role obtained a row that belongs to another tenant (runtime evidence under test roles)."
              },
              "help": {
                "text": "Constrain every permissive SELECT policy with the tenant predicate; remove constant-TRUE policies.\nMinimum evidence: Runtime evidence under test roles",
                "markdown": "**Remediation:** Constrain every permissive SELECT policy with the tenant predicate; remove constant-TRUE policies.\n\n**Minimum evidence:** Runtime evidence under test roles"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "isolation"
                ],
                "precision": "high"
              },
              "helpUri": "https://www.postgresql.org/docs/current/ddl-rowsecurity.html"
            },
            {
              "id": "RLS-008",
              "name": "PrivilegedViewExposureWithOwnerPolicyContext",
              "shortDescription": {
                "text": "Privileged view exposure with owner-policy context"
              },
              "fullDescription": {
                "text": "A view without security_invoker runs with its owner's privileges; if the owner bypasses RLS on the base table, the view exposes rows across tenants."
              },
              "help": {
                "text": "ALTER VIEW <view> SET (security_invoker = true) (PostgreSQL 15+), or move the tenant filter into the view and revoke direct access.\nMinimum evidence: View metadata + role behavior test",
                "markdown": "**Remediation:** ALTER VIEW <view> SET (security_invoker = true) (PostgreSQL 15+), or move the tenant filter into the view and revoke direct access.\n\n**Minimum evidence:** View metadata + role behavior test"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "view"
                ],
                "precision": "high"
              },
              "helpUri": "https://www.postgresql.org/docs/current/sql-createview.html"
            },
            {
              "id": "RLS-009",
              "name": "SecurityDefinerMisuseCandidate",
              "shortDescription": {
                "text": "SECURITY DEFINER misuse candidate"
              },
              "fullDescription": {
                "text": "A SECURITY DEFINER function owned by a role that bypasses RLS on protected tables is executable by non-owner roles. Not every SECURITY DEFINER function is vulnerable; this is a candidate unless a runtime case confirms leakage."
              },
              "help": {
                "text": "Prefer SECURITY INVOKER; if DEFINER is required, pin search_path, check the caller's tenant inside the function, and REVOKE EXECUTE FROM PUBLIC.\nMinimum evidence: Function owner/grants/context + concrete behavior if claimed confirmed",
                "markdown": "**Remediation:** Prefer SECURITY INVOKER; if DEFINER is required, pin search_path, check the caller's tenant inside the function, and REVOKE EXECUTE FROM PUBLIC.\n\n**Minimum evidence:** Function owner/grants/context + concrete behavior if claimed confirmed"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "function"
                ],
                "precision": "high"
              },
              "helpUri": "https://www.postgresql.org/docs/current/sql-createfunction.html"
            },
            {
              "id": "RLS-010",
              "name": "UnexpectedGrantOrColumnPrivilege",
              "shortDescription": {
                "text": "Unexpected GRANT or column privilege"
              },
              "fullDescription": {
                "text": "Effective SQL privileges differ from the privileges the spec expects for a role."
              },
              "help": {
                "text": "REVOKE the unexpected privilege (or update the expectation if the privilege is intended).\nMinimum evidence: Catalog + user-defined permission expectations",
                "markdown": "**Remediation:** REVOKE the unexpected privilege (or update the expectation if the privilege is intended).\n\n**Minimum evidence:** Catalog + user-defined permission expectations"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "grants"
                ],
                "precision": "high"
              },
              "helpUri": "https://www.postgresql.org/docs/current/sql-grant.html"
            },
            {
              "id": "RLS-014",
              "name": "TruncateReferencesTriggerGrantOutsideRls",
              "shortDescription": {
                "text": "TRUNCATE / REFERENCES / TRIGGER grant outside RLS"
              },
              "fullDescription": {
                "text": "TRUNCATE, REFERENCES and TRIGGER privileges are not governed by row-level policies. This is a distinct privilege finding, not an RLS bypass."
              },
              "help": {
                "text": "REVOKE TRUNCATE, REFERENCES, TRIGGER ON <table> FROM <role>.\nMinimum evidence: Explicit distinct privilege finding",
                "markdown": "**Remediation:** REVOKE TRUNCATE, REFERENCES, TRIGGER ON <table> FROM <role>.\n\n**Minimum evidence:** Explicit distinct privilege finding"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "grants"
                ],
                "precision": "medium"
              },
              "helpUri": "https://www.postgresql.org/docs/current/sql-grant.html"
            },
            {
              "id": "RLS-015",
              "name": "UnexpectedAnonymousAccess",
              "shortDescription": {
                "text": "Unexpected anonymous access"
              },
              "fullDescription": {
                "text": "The anonymous/guest identity can read or write rows the spec expects it to be denied."
              },
              "help": {
                "text": "Remove anonymous grants and PUBLIC policies on private tables; expose only explicitly public rows.\nMinimum evidence: Actual guest identity + applicable policy/grant",
                "markdown": "**Remediation:** Remove anonymous grants and PUBLIC policies on private tables; expose only explicitly public rows.\n\n**Minimum evidence:** Actual guest identity + applicable policy/grant"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "isolation"
                ],
                "precision": "high"
              },
              "helpUri": "https://www.postgresql.org/docs/current/ddl-rowsecurity.html"
            },
            {
              "id": "RLS-017",
              "name": "AccidentalAllTenantWriteBySharedRole",
              "shortDescription": {
                "text": "Accidental all-tenant write by shared role"
              },
              "fullDescription": {
                "text": "A shared (non-tenant-bound) role or group modified rows across tenants in a controlled mutation test."
              },
              "help": {
                "text": "Bind write policies to the tenant predicate even for shared or support roles.\nMinimum evidence: Test identity + mutation proof",
                "markdown": "**Remediation:** Bind write policies to the tenant predicate even for shared or support roles.\n\n**Minimum evidence:** Test identity + mutation proof"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "isolation"
                ],
                "precision": "high"
              },
              "helpUri": "https://www.postgresql.org/docs/current/sql-createpolicy.html"
            },
            {
              "id": "RLS-020",
              "name": "UncoveredTenantTableOperation",
              "shortDescription": {
                "text": "Uncovered tenant table / operation"
              },
              "fullDescription": {
                "text": "A protected table or SQL operation has no expectation in the spec, so its boundary is unverified. This is coverage tracking, not a vulnerability by itself."
              },
              "help": {
                "text": "Add ALLOW/DENY expectations for the missing actor/operation combinations.\nMinimum evidence: Coverage tracking, not vulnerability by itself",
                "markdown": "**Remediation:** Add ALLOW/DENY expectations for the missing actor/operation combinations.\n\n**Minimum evidence:** Coverage tracking, not vulnerability by itself"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "postgresql",
                  "row-level-security",
                  "coverage"
                ],
                "precision": "medium"
              },
              "helpUri": "https://www.postgresql.org/docs/current/ddl-rowsecurity.html"
            }
          ],
          "properties": {
            "ruleset": "2026.10.1"
          }
        }
      },
