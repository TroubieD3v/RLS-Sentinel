# Copy to .env or, better, run `python scripts/make_env.py` to generate random values.
# These are placeholders: do not reuse them anywhere.
SENTINEL_API_TOKEN=change-me-long-random-token
METADATA_DB_PASSWORD=change-me-metadata
FIXTURE_DB_PASSWORD=change-me-disposable-lab
# Hosts/CIDRs the app may connect to for READ-ONLY scans of an authorised source database (comma separated).
# Empty means NO source database can be scanned from the container (fail closed). Never add a production host you are not authorised to audit.
SENTINEL_ALLOWED_TARGETS=
